s.estat(r, "ic")   # AIC(lm(mpg ~ wt + hp, mtcars)) is larger by 2

# interactions without prefixes, with a note on how the variables enter
d2 <- transform(mtcars, am = factor(am, labels = c("automatic", "manual")))
s.regress(d2, mpg, "wt##am")
